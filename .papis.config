# Shared papis settings for the thesis library (tracked in git).
# Each user includes this file from ~/.config/papis/config:
#   [settings]
#   default-library = thesis
#   [thesis]
#   dir = ~/Downloads/material/thesis
#   [include]
#   thesis = ~/Downloads/material/thesis/.papis.config
# Requires paperlib installed into the papis venv (pipx inject papis --editable tools/paperlib).

[thesis]
formatter = thesis
add-folder-name = {thesis_name}
add-file-name = {thesis_name}
doc-paths-lowercase = False
doc-paths-extra-chars = _-
doc-paths-word-separator = _
ref-format = {doc[author_list][0][family]}{doc[year]}{doc[title]:1S}
