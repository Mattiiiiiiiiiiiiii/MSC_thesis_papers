@misc{Rheinboldt2017Iterative,
  abstract = {\ensuremath{<}jats:title\ensuremath{>}Abstract\ensuremath{<}/jats:title\ensuremath{>}
                  \ensuremath{<}jats:p\ensuremath{>}An overview of the basic theory of iterative methods for solving systems of nonlinear equations is presented. The emphasis is on considering the methods as discrete-time, dynamical systems, where examples of the complicated process flows call for adaptive controls. Overviews of existence theories, condition numbers, convergence orders, and basic convergence results are given. Principal members of the class of linearization methods are surveyed, including Newton's method and related forms, as well as some Broyden and inexact Newton methods. Then, equations arising in parameterized problems are considered and an introduction to the computational analysis of their solution manifolds and the related bifurcation problems is given. In the case of one-dimensional manifolds, this includes a discussion of some continuation methods.\ensuremath{<}/jats:p\ensuremath{>}},
  author = {Rheinboldt, Werner C.},
  doi = {10.1002/9781119176817.ecm2020},
  isbn = {9781119176817},
  journal = {Encyclopedia of Computational Mechanics Second Edition},
  language = {en},
  month = {12},
  pages = {1--27},
  publisher = {Wiley},
  title = {Iterative Solutions of Nonlinear Systems, Solution Manifolds, and Bifurcations},
  url = {https://doi.org/10.1002/9781119176817.ecm2020},
  year = {2017},
}

