@misc{van_der_Vorst2017Linear,
  abstract = {\ensuremath{<}jats:title\ensuremath{>}Abstract\ensuremath{<}/jats:title\ensuremath{>}
                  \ensuremath{<}jats:p\ensuremath{>}This chapter gives an overview of the most widely used numerical methods for the solution of linear systems of equations and for eigenproblems, including direct methods and iterative methods. Iterative methods are often used in combination with the so-called preconditioning operators. We will give a brief overview of the various preconditioners that exist. For eigenproblems of the type , the QR method is discussed. The QR method is expensive for larger values of , and for these larger values, a number of iterative methods, including the Lanczos method, Arnoldi's method, and the Jacobi{\textendash}Davidson method are shown.\ensuremath{<}/jats:p\ensuremath{>}},
  author = {van der Vorst, Henk A. and Vuik, Cornelis},
  doi = {10.1002/9781119176817.ecm2016},
  isbn = {9781119176817},
  journal = {Encyclopedia of Computational Mechanics Second Edition},
  language = {en},
  month = {12},
  pages = {1--28},
  publisher = {Wiley},
  title = {Linear Algebraic Solvers and Eigenvalue Analysis},
