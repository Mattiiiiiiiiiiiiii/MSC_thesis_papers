@article{Hornung1963The,
  abstract = {\ensuremath{<}jats:p\ensuremath{>}The mean velocity distribution in a low-speed three-dimensional turbulent boundary-layer flow was investigated experimentally. The experiments were performed on a large-scale model which consisted of a flat plate on which secondary flow was generated by the pressure field introduced by a circular cylinder standing on the plate. The Reynolds number based on distance from the leading edge of the plate was about 6 x 10\ensuremath{<}jats:sup\ensuremath{>}6\ensuremath{<}/jats:sup\ensuremath{>}.\ensuremath{<}/jats:p\ensuremath{>}\ensuremath{<}jats:p\ensuremath{>}It was found that the wall-wake model of Coles does not apply for flow of this kind and the model breaks down in the case of conically divergent flow with rising pressure, for example, in the results of Kehl (1943). The triangular model for the yawed turbulent boundary layer proposed by Johnston (1960) was confirmed with good correlation. However, the value of\ensuremath{<}jats:italic\ensuremath{>}y\ensuremath{<}/jats:italic\ensuremath{>}\ensuremath{<}jats:italic\ensuremath{>}u\ensuremath{<}/jats:italic\ensuremath{>}\ensuremath{<}jats:sub\ensuremath{>}\ensuremath{\tau}\ensuremath{<}/jats:sub\ensuremath{>}/\ensuremath{<}jats:italic\ensuremath{>}v\ensuremath{<}/jats:italic\ensuremath{>}which occurs at the vertex of the triangle was found to range up to 150 whereas Johnston gives the highest value as about 16 and hence assumes that the peak lies within the viscous sublayer. Much of his analysis is based on this assumption.\ensuremath{<}/jats:p\ensuremath{>}\ensuremath{<}jats:p\ensuremath{>}The dimensionless velocity-defect profile was found to lie in a fairly narrow band when plotted against\ensuremath{<}jats:italic\ensuremath{>}y\ensuremath{<}/jats:italic\ensuremath{>}/\ensuremath{\delta} for a wide variation of other parameters including the pressure gradient. The law of the wall was found to apply in the same form as for two-dimensional flow but for a more limited range of\ensuremath{<}jats:italic\ensuremath{>}y\ensuremath{<}/jats:italic\ensuremath{>}.\ensuremath{<}/jats:p\ensuremath{>}},
  author = {Hornung, H. G. and Joubert, P. N.},
  doi = {10.1017/s0022112063000318},
  issue = {3},
  journal = {Journal of Fluid Mechanics},
  language = {en},
  month = {3},
  pages = {368--384},
  publisher = {Cambridge University Press (CUP)},
  title = {The mean velocity profile in three-dimensional turbulent boundary layers},
  url = {https://doi.org/10.1017/s0022112063000318},
  volume = {15},
  year = {1963},
}

@article{Hosseini2024A,
  abstract = {\ensuremath{<}jats:p\ensuremath{>}In this research, the architecture and the functionalities of the LAMBDA (Laboratory of Aircraft Multidisciplinary Knowledge-Based Design and Analysis) framework for the design, analysis, and optimization of civil aircraft are presented. The framework is developed in MATLAB R2022a and comprises a modular architecture, which gives the potential for the use of different methods and fidelities for each discipline. The methods can be selected from a set of built-in methods or custom user-defined scripts. Disciplinary modules of the LAMBDA are Requirements, Weight, Sizing, Geometry, Aerodynamics, Engine, Performance, Cost, Emission, and Optimization. This framework has been used for different types of design and optimization problems. When it is applied for the design and optimization of a novel regional TBW (Truss-Braced Wing) aircraft, the operating cost has been reduced by 7.7\% in the optimum configuration compared to the base configuration.\ensuremath{<}/jats:p\ensuremath{>}},
  author = {Hosseini, Saeed and Vaziry-Zanjany, Mohammad Ali and Ovesy, Hamid Reza},
