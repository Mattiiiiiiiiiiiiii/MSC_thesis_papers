@misc{Stein2017Finite,
  abstract = {\ensuremath{<}jats:title\ensuremath{>}Abstract\ensuremath{<}/jats:title\ensuremath{>}
                  \ensuremath{<}jats:p\ensuremath{>}The essential topics of classical and advanced adaptive finite element methods (FEMs) for linear and finite elastic deformations of solids and structures are presented in this chapter from both the mechanical and mathematical point of view.\ensuremath{<}/jats:p\ensuremath{>}
                  \ensuremath{<}jats:p\ensuremath{>}As the mechanical and mathematical basis, nonlinear and linearized theories of elasticity are derived in a rigorous way, followed by the classical variational principles of elasticity, which are the basis for FEM, derived for classical and advanced Ritz{\textendash}Galerkin methods, such as the extended finite element method (XFEM) and the meshfree reproducing kernel particle method (RKPM). Next to the discrete (one-field) Dirichlet minimization principle, the (two-field) Hellinger{\textendash}Reissner stationary dual-mixed principle and the (three-field) Hu{\textendash}Washizu stationary mixed principle are presented, including the main features of the associated FEMs.\ensuremath{<}/jats:p\ensuremath{>}
                  \ensuremath{<}jats:p\ensuremath{>}
                    The main objective of this chapter is the systematic treatment of
                    \ensuremath{<}jats:italic\ensuremath{>}a posteriori\ensuremath{<}/jats:italic\ensuremath{>}
                    error estimators and their applications to both
                    \ensuremath{<}jats:italic\ensuremath{>}verification\ensuremath{<}/jats:italic\ensuremath{>}
                    , that is, efficient mesh and particle adaptivity in order to achieve optimal convergence rates for the discretized solutions with prescribed error tolerances, and
                    \ensuremath{<}jats:italic\ensuremath{>}validation\ensuremath{<}/jats:italic\ensuremath{>}
                    , that is, error-controlled model adaptivity combined with
                    \ensuremath{<}jats:italic\ensuremath{>}verification\ensuremath{<}/jats:italic\ensuremath{>}
                    .
                  \ensuremath{<}/jats:p\ensuremath{>}
                  \ensuremath{<}jats:p\ensuremath{>}
                    In the framework of
                    \ensuremath{<}jats:italic\ensuremath{>}verification\ensuremath{<}/jats:italic\ensuremath{>}
                    , linearized and finite elasticity problems are treated, using both energy-norm and goal-oriented
                    \ensuremath{<}jats:italic\ensuremath{>}a posteriori\ensuremath{<}/jats:italic\ensuremath{>}
                    error estimators for mesh-based and meshfree methods. The four basic classes, that is, residual-type, hierarchical-type, gradient averaging-type, and constitutive equation error estimators are presented and applied, for example, to fracture mechanics problems.
                  \ensuremath{<}/jats:p\ensuremath{>}
                  \ensuremath{<}jats:p\ensuremath{>}
                    A challenging topic in the framework of
                    \ensuremath{<}jats:italic\ensuremath{>}validation\ensuremath{<}/jats:italic\ensuremath{>}
                    is error-controlled expansive hierarchical modeling of 2D thin-walled elastic plates and shells to 3D-elastic continua by dimensional adaptivity of the underlying mathematical models, especially in subdomains with boundary layers and other disturbances where model expansion is necessary for validation.
                  \ensuremath{<}/jats:p\ensuremath{>}},
  author = {Stein, Erwin and R\"uter, Marcus Olavi},
  doi = {10.1002/9781119176817.ecm2025},
  isbn = {9781119176817},
  journal = {Encyclopedia of Computational Mechanics Second Edition},
  language = {en},
  month = {12},
  pages = {1--96},
  publisher = {Wiley},
  title = {Finite Element Methods for Elasticity with Error-Controlled Discretization and Model Adaptivity},
  url = {https://doi.org/10.1002/9781119176817.ecm2025},
  year = {2017},
}

